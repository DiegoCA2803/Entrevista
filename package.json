{
  "name": "mineratech-fleet-control",
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema de Control de Flota, Asignaciones y Mantenimiento Minero",
  "main": "backend/dist/server.js",
  "scripts": {
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "tsc -p backend/tsconfig.json && node scripts/copy-schema.mjs",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node backend/dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx backend/src/seeds/seed.ts",
    "setup": "node scripts/setup-env.mjs",
    "setup:vercel": "node scripts/setup-vercel-env.mjs",
    "worker": "tsx backend/src/worker.ts",
    "notifications": "tsx backend/src/notification-sink.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "test:evidence": "node scripts/test-evidence.mjs"
  },
  "keywords": [
    "mining",
    "fleet-management",
    "soa",
    "layered-architecture",
    "maintenance"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "engines": {
    "node": "22.x"
  }
}
