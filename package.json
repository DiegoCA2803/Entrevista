{
  "name": "mineratech-fleet-control",
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema de Control de Flota, Asignaciones y Mantenimiento Minero",
  "main": "backend/dist/server.js",
  "scripts": {
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node backend/dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx backend/src/seeds/seed.ts"
  },
  "keywords": [
    "mining",
    "fleet-management",
    "soa",
    "layered-architecture",
    "maintenance"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
