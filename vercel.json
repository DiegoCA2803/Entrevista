{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "services": {
    "app": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "installCommand": "npm ci --include=dev && npm ci --include=dev --prefix frontend"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "app" } }],
  "crons": [{ "path": "/api/cron/outbox", "schedule": "0 8 * * *" }]
}
